digraph ER { graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.1, fontname="Times-Roman", pad=0.3, dpi=220];
node [shape=plain, fontname="Times-Roman", fontsize=11]; edge [fontname="Times-Roman", fontsize=11, arrowhead=none, color="#333333"];
DEPARTMENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>DEPARTMENT</b></font></td></tr><tr><td align="left" port="dept_id"><u>dept_id</u></td><td align="left"><font color="#555555">PK</font></td></tr><tr><td align="left" port="dept_name">dept_name</td><td align="left"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="location">location</td><td align="left"> </td></tr></table>>];
DOCTOR [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>DOCTOR</b></font></td></tr><tr><td align="left" port="doctor_id"><u>doctor_id</u></td><td align="left"><font color="#555555">PK</font></td></tr><tr><td align="left" port="doctor_name">doctor_name</td><td align="left"> </td></tr><tr><td align="left" port="dept_id">dept_id</td><td align="left"><font color="#555555">FK</font></td></tr><tr><td align="left" port="specialization">specialization</td><td align="left"> </td></tr><tr><td align="left" port="consult_fee">consult_fee</td><td align="left"> </td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="max_daily_slots">max_daily_slots</td><td align="left"> </td></tr></table>>];
PATIENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>PATIENT</b></font></td></tr><tr><td align="left" port="patient_id"><u>patient_id</u></td><td align="left"><font color="#555555">PK</font></td></tr><tr><td align="left" port="patient_name">patient_name</td><td align="left"> </td></tr><tr><td align="left" port="dob">dob</td><td align="left"> </td></tr><tr><td align="left" port="gender">gender</td><td align="left"> </td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="registered_on">registered_on</td><td align="left"> </td></tr></table>>];
APPOINTMENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>APPOINTMENT</b></font></td></tr><tr><td align="left" port="appt_id"><u>appt_id</u></td><td align="left"><font color="#555555">PK</font></td></tr><tr><td align="left" port="patient_id">patient_id</td><td align="left"><font color="#555555">FK</font></td></tr><tr><td align="left" port="doctor_id">doctor_id</td><td align="left"><font color="#555555">FK</font></td></tr><tr><td align="left" port="appt_date">appt_date</td><td align="left"> </td></tr><tr><td align="left" port="slot_no">slot_no</td><td align="left"> </td></tr><tr><td align="left" port="status">status</td><td align="left"> </td></tr><tr><td align="left" port="booked_on">booked_on</td><td align="left"> </td></tr></table>>];
MEDICINE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>MEDICINE</b></font></td></tr><tr><td align="left" port="med_id"><u>med_id</u></td><td align="left"><font color="#555555">PK</font></td></tr><tr><td align="left" port="med_name">med_name</td><td align="left"><font color="#555555">UQ</font></td></tr><tr><td align="left" port="unit_price">unit_price</td><td align="left"> </td></tr><tr><td align="left" port="stock_qty">stock_qty</td><td align="left"> </td></tr><tr><td align="left" port="reorder_level">reorder_level</td><td align="left"> </td></tr></table>>];
PRESCRIPTION [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>PRESCRIPTION</b></font></td></tr><tr><td align="left" port="appt_id"><u>appt_id</u></td><td align="left"><font color="#555555">PK, FK</font></td></tr><tr><td align="left" port="med_id"><u>med_id</u></td><td align="left"><font color="#555555">PK, FK</font></td></tr><tr><td align="left" port="quantity">quantity</td><td align="left"> </td></tr><tr><td align="left" port="dosage">dosage</td><td align="left"> </td></tr></table>>];
BILL [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>BILL</b></font></td></tr><tr><td align="left" port="bill_id"><u>bill_id</u></td><td align="left"><font color="#555555">PK</font></td></tr><tr><td align="left" port="appt_id">appt_id</td><td align="left"><font color="#555555">FK, UQ</font></td></tr><tr><td align="left" port="consult_amt">consult_amt</td><td align="left"> </td></tr><tr><td align="left" port="med_amt">med_amt</td><td align="left"> </td></tr><tr><td align="left" port="gst_rate">gst_rate</td><td align="left"> </td></tr><tr><td align="left" port="payment_status">payment_status</td><td align="left"> </td></tr><tr><td align="left" port="generated_on">generated_on</td><td align="left"> </td></tr><tr><td align="left" port="paid_on">paid_on</td><td align="left"> </td></tr></table>>];
APPT_AUDIT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="2" bgcolor="#1f4e79"><font color="white"><b>APPT_AUDIT</b></font></td></tr><tr><td align="left" port="audit_id"><u>audit_id</u></td><td align="left"><font color="#555555">PK</font></td></tr><tr><td align="left" port="appt_id">appt_id</td><td align="left"> </td></tr><tr><td align="left" port="old_status">old_status</td><td align="left"> </td></tr><tr><td align="left" port="new_status">new_status</td><td align="left"> </td></tr><tr><td align="left" port="changed_on">changed_on</td><td align="left"> </td></tr><tr><td align="left" port="changed_by">changed_by</td><td align="left"> </td></tr></table>>];
DEPARTMENT -> DOCTOR [xlabel="has\n1 : N"];
DOCTOR -> APPOINTMENT [xlabel="attends\n1 : N"];
PATIENT -> APPOINTMENT [xlabel="books\n1 : N"];
APPOINTMENT -> PRESCRIPTION [xlabel="contains\n1 : N"];
MEDICINE -> PRESCRIPTION [xlabel="dispensed in\n1 : N"];
APPOINTMENT -> BILL [xlabel="billed by\n1 : 0..1"];
APPOINTMENT -> APPT_AUDIT [xlabel="logged in\n1 : N"];
{rank=same; DEPARTMENT; PATIENT;} {rank=same; MEDICINE; BILL; APPT_AUDIT;}
}